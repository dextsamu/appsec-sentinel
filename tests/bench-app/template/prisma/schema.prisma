model Organization { id String @id @default(cuid()) name String slug String @unique users User[] quotes Quote[] }
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role String @default("VOLONTARIO") // ADMIN | RESPONSABILE | VOLONTARIO
  isAdmin Boolean @default(false)
  isActive Boolean @default(true)
  mfaEnabled Boolean @default(false)
  totpSecret String?
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
}
model Quote { id String @id @default(cuid()) customerName String customerEmail String customerPhone String amount Int organizationId String organization Organization @relation(fields: [organizationId], references: [id]) }
model Ticket { id String @id @default(cuid()) title String ownerId String organizationId String }
model Session { id String @id @default(cuid()) userId String token String @unique expiresAt DateTime }
